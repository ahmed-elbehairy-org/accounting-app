{
  "name": "accounting-monorepo",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "frontend",
    "backend"
  ],
  "scripts": {
    "dev": "concurrently -n \"BACK,FRONT\" -c \"blue,green\" \"npm run dev --workspace=backend\" \"npm run dev --workspace=frontend\"",
    "build": "npm run build --workspaces",
    "front": "npm run dev --workspace=frontend",
    "back": "npm run dev --workspace=backend",
    "build:front": "npm run build --workspace=frontend",
    "build:back": "npm run build --workspace=backend",
    "start:back": "npm run start --workspace=backend"
  },
  "devDependencies": {
    "concurrently": "^10.0.6"
  }
}
