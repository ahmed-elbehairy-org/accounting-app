{
  "name": "accounting-monorepo",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "frontend",
    "backend"
  ],
  "scripts": {
    "dev": "npm run dev --workspace=frontend",
    "front": "npm run dev --workspace=frontend",
    "back": "npm run dev --workspace=backend",
    "build": "npm run build --workspaces",
    "build:front": "npm run build --workspace=frontend",
    "build:back": "npm run build --workspace=backend",
    "start:back": "npm run start --workspace=backend"
  }
}
